-- SLIDER -------------------------------------------------------------------
function Module:AddSlider(name, o, callback)
	o = o or {}
	local min, max, inc = o.Min or 0, o.Max or 100, o.Increment or 1
	local suffix = o.Suffix or ""
	local value = clamp(o.Default or min, min, max)

	local f = self:_row(32)
	elementLabel(f, name, UDim2.new(0.6, 0, 0, 14))
	local valLbl = text({
		TextSize = 11, TextColor3 = Theme.TextDim, TextXAlignment = Enum.TextXAlignment.Right,
		AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0.4, 0, 0, 14),
		Parent = f,
	})
	local track = new("Frame", {
		BackgroundColor3 = Theme.Off, BorderSizePixel = 0, Position = UDim2.fromOffset(0, 22),
		Size = UDim2.new(1, 0, 0, 4), Parent = f,
	}, { corner(2) })
	local fill = new("Frame", {
		BackgroundColor3 = Theme.Accent, BorderSizePixel = 0, Size = UDim2.fromScale(0, 1), Parent = track,
	}, { corner(2) })
	local knob = new("Frame", {
		BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.fromOffset(10, 10), Parent = track,
	}, { corner(10) })
	onAccent(function(c) fill.BackgroundColor3 = c end)

	local function render(anim)
		local a = (value - min) / math.max(max - min, 1e-9)
		local ti = anim and TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out) or TweenInfo.new(0)
		tween(fill, { Size = UDim2.fromScale(a, 1) }, ti)
		tween(knob, { Position = UDim2.new(a, 0, 0.5, 0) }, ti)
		valLbl.Text = fmtNumber(value, inc) .. suffix
	end
	local function setValue(v, silent)
		v = clamp(math.floor(v / inc + 0.5) * inc, min, max)
		v = tonumber(string.format("%.6f", v))
		if v == value and silent == nil then return end
		value = v
		render(true)
		if not silent then safe(callback, value) end
	end
	render(false)

	local hit = textButton({
		Position = UDim2.fromOffset(0, 14), Size = UDim2.new(1, 0, 0, 18), Parent = f,
	})
	local dragging = false
	local function fromInput(i)
		local a = clamp((i.Position.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
		setValue(min + (max - min) * a)
	end
	hit.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			tween(knob, { Size = UDim2.fromOffset(14, 14) }, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out))
			tween(valLbl, { TextColor3 = Theme.Accent })
			fromInput(i)
		end
	end)
	table.insert(self.Window.Conns, UserInputService.InputChanged:Connect(function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			fromInput(i)
		end
	end))
	table.insert(self.Window.Conns, UserInputService.InputEnded:Connect(function(i)
		if (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) and dragging then
			dragging = false
			tween(knob, { Size = UDim2.fromOffset(10, 10) }, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out))
			tween(valLbl, { TextColor3 = Theme.TextDim })
		end
	end))

	local el = { Type = "Slider", Name = name }
	function el:Get() return value end
	function el:Set(v, silent) setValue(tonumber(v) or min, silent) end
	table.insert(self.Elements, el)
	return el
end

-- DROPDOWN / MULTI ---------------------------------------------------------
function Module:_dropdown(name, o, callback, multi, order, internal)
	o = o or {}
	local options = o.Options or {}
	local selected, current = {}, nil
	if multi then
		for _, v in ipairs(o.Default or {}) do selected[v] = true end
	else
		current = o.Default or options[1]
	end

	local f = self:_row(24, order)
	local head = textButton({
		BackgroundColor3 = Theme.Element, BackgroundTransparency = 0.1, Size = UDim2.new(1, 0, 0, 24), Parent = f,
	})
	corner(6).Parent = head
	text({
		Text = name, TextSize = 11, Position = UDim2.fromOffset(8, 0), Size = UDim2.new(0.45, -8, 1, 0),
		TextTruncate = Enum.TextTruncate.AtEnd, Parent = head,
	})
	local valLbl = text({
		TextSize = 11, TextColor3 = Theme.Accent, TextXAlignment = Enum.TextXAlignment.Right,
		AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 0), Size = UDim2.new(0.55, -14, 1, 0),
		TextTruncate = Enum.TextTruncate.AtEnd, Parent = head,
	})
	onAccent(function(c) valLbl.TextColor3 = c end)

	local list = new("ScrollingFrame", {
		BackgroundColor3 = Theme.Element, BackgroundTransparency = 0.35, BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 28), Size = UDim2.new(1, 0, 0, 0), CanvasSize = UDim2.new(),
		ScrollBarThickness = 2, ScrollBarImageColor3 = Theme.Knob, Visible = false,
		VerticalScrollBarInset = Enum.ScrollBarInset.None, Parent = f,
	}, { corner(6), new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }) })

	local open = false
	local function selectedList()
		local out = {}
		for _, opt in ipairs(options) do if selected[opt] then table.insert(out, opt) end end
		return out
	end
	local function display()
		if multi then
			local l = selectedList()
			valLbl.Text = #l == 0 and "None" or table.concat(l, ", ")
		else
			valLbl.Text = current ~= nil and tostring(current) or "None"
		end
	end
	local function resizeList(anim)
		local n = math.min(#options, 6) * 22
		list.CanvasSize = UDim2.fromOffset(0, #options * 22)
		local ti = anim and TweenInfo.new(0.26, Enum.EasingStyle.Quint, Enum.EasingDirection.Out) or TweenInfo.new(0)
		if open then list.Visible = true end
		tween(list, { Size = UDim2.new(1, 0, 0, open and n or 0) }, ti)
		tween(f, { Size = open and UDim2.new(1, 0, 0, 28 + n + 2) or UDim2.new(1, 0, 0, 24) }, ti)
		tween(head, { BackgroundTransparency = open and 0 or 0.1 }, ti)
		if not open then
			task.delay(anim and 0.27 or 0, function() if not open then list.Visible = false end end)
		end
	end
	local function rebuild()
		for _, c in ipairs(list:GetChildren()) do
			if c:IsA("TextButton") then c:Destroy() end
		end
		for i, opt in ipairs(options) do
			local isSel = multi and selected[opt] or (not multi and current == opt)
			local b = textButton({
				Text = tostring(opt), TextSize = 11, TextColor3 = isSel and Theme.Accent or Theme.TextDim,
				Size = UDim2.new(1, 0, 0, 22), LayoutOrder = i, Parent = list,
			})
			b.MouseEnter:Connect(function() if not (multi and selected[opt] or (not multi and current == opt)) then b.TextColor3 = Theme.Text end end)
			b.MouseLeave:Connect(function() local s2 = multi and selected[opt] or (not multi and current == opt); b.TextColor3 = s2 and Theme.Accent or Theme.TextDim end)
			b.MouseButton1Click:Connect(function()
				if multi then
					selected[opt] = not selected[opt] or nil
					display(); rebuild()
					safe(callback, selectedList())
				else
					current = opt
					open = false
					display(); rebuild(); resizeList(true)
					safe(callback, current)
				end
			end)
		end
	end
	head.MouseButton1Click:Connect(function() open = not open; resizeList(true) end)
	display(); rebuild(); resizeList(false)

	local el = { Type = multi and "MultiDropdown" or "Dropdown", Name = name }
	function el:Get() return multi and selectedList() or current end
	function el:Set(v, silent)
		if multi then
			selected = {}
			for _, x in ipairs(type(v) == "table" and v or {}) do selected[x] = true end
		else
			current = v
		end
		display(); rebuild()
		if not silent then safe(callback, el:Get()) end
	end
	function el:SetOptions(newOpts)
		options = newOpts
		if not multi and not table.find(options, current) then current = options[1] end
		display(); rebuild(); resizeList(false)
	end
	if not internal then table.insert(self.Elements, el) end
	return el
end

function Module:AddDropdown(name, o, callback) return self:_dropdown(name, o, callback, false) end
function Module:AddMultiDropdown(name, o, callback) return self:_dropdown(name, o, callback, true) end


function Window:SetVisible(v)
	self.Visible = v
	self._visToken = (self._visToken or 0) + 1
	local tk = self._visToken
	local base = self._baseScale or 1
	if v then
		self.Main.Visible = true
		self.Scale.Scale = base * 0.9
		tween(self.Scale, { Scale = base }, TweenInfo.new(0.38, Enum.EasingStyle.Back, Enum.EasingDirection.Out))
	else
		self:ClosePopup()
		tween(self.Scale, { Scale = base * 0.92 }, TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.In))
		task.delay(0.14, function()
			if self._visToken == tk then self.Main.Visible = false end
		end)
	end
	if self.BlurEffect then self.BlurEffect.Enabled = v end
end

function Window:SetToggleKey(k) self.ToggleKey = k end

function Window:Destroy()
	self:ClosePopup()
	for _, c in ipairs(self.Conns) do pcall(function() c:Disconnect() end) end
	if self.BlurEffect then self.BlurEffect:Destroy() end
	self.Gui:Destroy()
end

-- ПОПАПЫ -----------------------------------------------------------------
function Window:_anchorOf(inst, mode)
	local s = self.Scale.Scale
	local rel = (inst.AbsolutePosition - self.Main.AbsolutePosition) / s
	local size = inst.AbsoluteSize / s
	return { mode = mode, x = rel.X, y = rel.Y, w = size.X, h = size.Y }
end

function Window:_placePopup()
	local p, a = self._popup, self._anchor
	if not p or not a then return end
	local pw, ph = p.Size.X.Offset, p.Size.Y.Offset
	local x, y
	if a.mode == "side" then
		x = a.x + a.w + 10
		if x + pw > self.Width - 8 then x = a.x - pw - 10 end
		y = a.y - 10
	else
		x, y = a.x, a.y + a.h + 6
	end
	x = math.max(8, math.min(x, self.Width - pw - 8))
	y = math.max(8, math.min(y, self.Height - ph - 8))
	p.Position = UDim2.fromOffset(x, y)
end

function Window:_showPopup(popup, anchor, onClose)
	self:ClosePopup()
	self._popupToken = (self._popupToken or 0) + 1
	self._popup, self._anchor, self._popupOnClose = popup, anchor, onClose
	self.PopupLayer.Visible = true
	popup.Visible = true
	local r = self._resizers and self._resizers[popup]
	if r then r(); task.defer(r) end
	self:_placePopup()
	local sc = popup:FindFirstChild("PopScale")
	if sc then
		sc.Scale = 0.88
		tween(sc, { Scale = 1 }, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out))
	end
end

function Window:ClosePopup()
	local p = self._popup
	local cb = self._popupOnClose
	self._popupOnClose = nil
	self._popup, self._anchor = nil, nil
	if p then
		local sc = p:FindFirstChild("PopScale")
		if sc then tween(sc, { Scale = 0.92 }, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.In)) end
		self._popupToken = (self._popupToken or 0) + 1
		local tk = self._popupToken
		task.delay(0.1, function()
			if self._popup ~= p then p.Visible = false end
			if self._popupToken == tk and not self._popup then self.PopupLayer.Visible = false end
		end)
	else
		self.PopupLayer.Visible = false
	end
	if cb then cb() end
end

function Window:_spinArrow(open)
	if not self.CfgArrow then return end
	tween(self.CfgArrow, { Rotation = open and 90 or 0 }, TweenInfo.new(0.28, Enum.EasingStyle.Quint, Enum.EasingDirection.Out))
end

-- ПОИСК ------------------------------------------------------------------
function Window:_applySearch(allowSwitch)
	local q = (self._query or ""):lower()
	local tabHits = {}
	for _, tab in ipairs(self.Tabs) do
		for _, g in ipairs(tab.Groups) do
			local any = false
			for _, m in ipairs(g.Modules) do
				local ok = q == "" or m.Name:lower():find(q, 1, true) ~= nil
				m.Row.Visible = ok
				if ok then any = true; tabHits[tab] = true end
			end
			g.Frame.Visible = any or q == ""
		end
	end
	if allowSwitch and q ~= "" and self.CurrentTab and not tabHits[self.CurrentTab] then
		for _, tab in ipairs(self.Tabs) do
			if tabHits[tab] then tab:Select(); break end
		end
	end
end


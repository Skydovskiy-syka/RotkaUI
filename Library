function Tab:AddGroup(o)
	o = type(o) == "string" and { Name = o } or (o or {})
	local col = o.Column
	if not col then
		local weights = { 0, 0 }
		for _, g in ipairs(self.Groups) do
			weights[g.Column] += 14 + 27 * #g.Modules
		end
		col = weights[1] <= weights[2] and 1 or 2
	end
	local group = setmetatable({
		Tab = self, Window = self.Window, Name = o.Name or "Group", Modules = {}, Column = col,
	}, Group)

	local frame = new("Frame", {
		Name = "Group_" .. group.Name, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = #self.Groups + 1, Parent = self.Columns[col],
	}, { new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 3) }) })
	group.Frame = frame

	text({
		Name = "Label", Text = group.Name, TextSize = 10, TextColor3 = Theme.Label,
		Size = UDim2.new(1, 0, 0, 13), LayoutOrder = 1, Parent = frame,
	}, nil)
	padding(3, 0, 0, 0).Parent = frame.Label

	group.Panel = new("Frame", {
		Name = "Panel", BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.1,
		BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 2, Parent = frame,
	}, {
		corner(8),
		stroke(Color3.fromRGB(70, 75, 96), 1, 0.65),
		new("UIGradient", { Color = ColorSequence.new(Theme.PanelTop, Theme.PanelBottom), Rotation = 90 }),
		padding(2, 2, 2, 2),
		new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 0) }),
	})

	table.insert(self.Groups, group)
	return group
end


function Window:AddTab(o)
	o = type(o) == "string" and { Name = o } or (o or {})
	local tab = setmetatable({ Window = self, Name = o.Name or "Tab", Groups = {} }, Tab)

	local secName = o.Section or "Main"
	local sec = self._sections[secName]
	if not sec then
		self._sectionCount += 1
		sec = { Index = self._sectionCount, Count = 0 }
		self._sections[secName] = sec
		text({
			Name = "Section_" .. secName, Text = secName, TextSize = 10, TextColor3 = Theme.Label,
			Size = UDim2.new(1, 0, 0, 16), LayoutOrder = sec.Index * 100, Parent = self.Side,
		}, nil).Parent = self.Side
		padding(3, 0, 0, 0).Parent = self.Side:FindFirstChild("Section_" .. secName)
	end
	sec.Count += 1

	local btn = textButton({
		Name = "Tab_" .. tab.Name, BackgroundColor3 = Theme.Pill, BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 24), LayoutOrder = sec.Index * 100 + sec.Count, Parent = self.Side,
	})
	corner(7).Parent = btn
	tab.Button = btn
	tab.Icon = icon(btn, o.Icon or Library.Icons.Tabs[tab.Name], {
		AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 10, 0.5, 0),
		Size = UDim2.fromOffset(12, 12), Color = Theme.TextDim, Fallback = "square",
	})
	tab.Label = text({
		Text = tab.Name, TextSize = 12, TextColor3 = Theme.TextDim,
		Position = UDim2.fromOffset(30, 0), Size = UDim2.new(1, -34, 1, 0), Parent = btn,
	})
	btn.MouseButton1Click:Connect(function() tab:Select() end)
	btn.MouseEnter:Connect(function()
		if self.CurrentTab ~= tab then tween(tab.Label, { TextColor3 = Theme.Text }) end
	end)
	btn.MouseLeave:Connect(function()
		if self.CurrentTab ~= tab then tween(tab.Label, { TextColor3 = Theme.TextDim }) end
	end)

	-- страница с двумя колонками
	local page = new("ScrollingFrame", {
		Name = "Page_" .. tab.Name, BackgroundTransparency = 1, BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 1, -8), CanvasSize = UDim2.new(), ScrollBarThickness = 2,
		ScrollBarImageColor3 = Theme.Knob, ScrollBarImageTransparency = 0.5,
		VerticalScrollBarInset = Enum.ScrollBarInset.None, ScrollingDirection = Enum.ScrollingDirection.Y,
		Visible = false, Parent = self.PageHolder,
	})
	local function column(name, pos)
		local l = new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 7) })
		local f = new("CanvasGroup", {
			Name = name, BackgroundTransparency = 1, Position = pos, Size = UDim2.new(0.5, -11, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y, Parent = page,
		}, { l })
		return f, l
	end
	local c1, l1 = column("Left", UDim2.new(0, 5, 0, 0))
	local c2, l2 = column("Right", UDim2.new(0.5, 3, 0, 0))
	local function upd()
		page.CanvasSize = UDim2.fromOffset(0, math.max(l1.AbsoluteContentSize.Y, l2.AbsoluteContentSize.Y) + 6)
	end
	l1:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(upd)
	l2:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(upd)

	tab.Page, tab.Columns = page, { c1, c2 }
	tab.ColBase = { c1.Position, c2.Position }
	tab.Index = #self.Tabs + 1
	table.insert(self.Tabs, tab)
	if #self.Tabs == 1 then tab:Select() end
	return tab
end

function Window:_tabY(btn)
	local list = {}
	for _, c in ipairs(self.Side:GetChildren()) do
		if c:IsA("GuiObject") then table.insert(list, c) end
	end
	table.sort(list, function(a, b) return a.LayoutOrder < b.LayoutOrder end)
	local y = 0
	for _, c in ipairs(list) do
		if c == btn then return y end
		y += c.Size.Y.Offset + 2
	end
	return 0
end

function Window:_movePill(tab, instant)
	local target = UDim2.fromOffset(0, self:_tabY(tab.Button))
	if instant then
		self.Pill.Position = target
		self.Pill.BackgroundTransparency = 0.35
		self.PillBar.Size = UDim2.fromOffset(2, 12)
	else
		tween(self.Pill, { Position = target }, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out))
		self.PillBar.Size = UDim2.fromOffset(2, 3)
		tween(self.PillBar, { Size = UDim2.fromOffset(2, 12) }, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out))
	end
end

function Tab:Select()
	local w = self.Window
	if w.CurrentTab == self then return end
	local old = w.CurrentTab
	local dir = 0
	self._token = (self._token or 0) + 1

	if old then
		dir = (self.Index > old.Index) and 1 or -1
		old._token = (old._token or 0) + 1
		local tk = old._token
		for _, col in ipairs(old.Columns) do
			tween(col, { GroupTransparency = 1 }, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out))
		end
		task.delay(0.13, function()
			if old._token == tk and w.CurrentTab ~= old then old.Page.Visible = false end
		end)
		tween(old.Label, { TextColor3 = Theme.TextDim, Position = UDim2.fromOffset(30, 0) })
		iconColor(old.Icon, Theme.TextDim)
	end

	w.CurrentTab = self
	w:ClosePopup()
	w:_movePill(self, old == nil)

	self.Page.Visible = true
	self.Page.CanvasPosition = Vector2.zero
	for i, col in ipairs(self.Columns) do
		local base = self.ColBase[i]
		col.GroupTransparency = 1
		col.Position = UDim2.new(base.X.Scale, base.X.Offset + dir * 26, base.Y.Scale, base.Y.Offset + (dir == 0 and 14 or 6))
		task.delay((i - 1) * 0.05, function()
			if w.CurrentTab ~= self then return end
			tween(col, { GroupTransparency = 0, Position = base }, TweenInfo.new(0.45, Enum.EasingStyle.Quint, Enum.EasingDirection.Out))
		end)
	end

	tween(self.Label, { TextColor3 = Color3.new(1, 1, 1), Position = UDim2.fromOffset(33, 0) })
	iconColor(self.Icon, Color3.new(1, 1, 1))
	tween(self.Icon, { Size = UDim2.fromOffset(15, 15) }, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out))
	task.delay(0.1, function()
		tween(self.Icon, { Size = UDim2.fromOffset(12, 12) }, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out))
	end)
end


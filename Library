function Module:_ensurePopup()
	if self.Popup then return end
	local win = self.Window
	local popup, scroller, layout = makePopup(win, 212, self.Name, 270)
	self.Popup, self.Scroller = popup, scroller
	if self.BindObj then
		self.BindEl = self:_keybind("Keybind", self.BindObj, 10000)
		self.ModeEl = self:_dropdown("Bind Mode", { Options = { "Toggle", "Hold" }, Default = self.BindObj.Mode },
			function(m) self.BindObj.Mode = m; self.BindObj.State = false end, false, 10001, true)
	end
end

function Module:OpenSettings()
	self:_ensurePopup()
	local win = self.Window
	if win._popup == self.Popup then win:ClosePopup(); return end
	win:_showPopup(self.Popup, win:_anchorOf(self.GearBtn, "side"), function() self:_spinGear(false) end)
	self:_spinGear(true)
end

function Module:_spinGear(open)
	self._gearOpen = open
	if not self.GearIcon then return end
	tween(self.GearIcon, { Rotation = open and 180 or 0 }, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out))
end

function Module:_row(h, order)
	self:_ensurePopup()
	self._order += 1
	return new("Frame", {
		BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, h),
		LayoutOrder = order or self._order, Parent = self.Scroller,
	})
end

local function elementLabel(parent, str, w)

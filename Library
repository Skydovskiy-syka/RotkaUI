	}, Module)

	local row = new("Frame", {
		Name = mod.Name, BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1,
		BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 27), LayoutOrder = #self.Modules + 1,

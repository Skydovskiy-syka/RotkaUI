	local hit = textButton({ Name = "Hit", Size = UDim2.fromScale(1, 1), Parent = row })
	local nameLbl = text({
		Name = "Name", Text = mod.Name, TextSize = 12, Position = UDim2.fromOffset(8, 0),
		Size = UDim2.new(1, -70, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd, Parent = row,
	})

	mod.NameLabel = nameLbl
	local gearRight = mod.HasToggle and -39 or -8
	local gear = textButton({
		Name = "Gear", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, gearRight, 0.5, 0),
		Size = UDim2.fromOffset(18, 18), Parent = row,
	})
	local gearIcon = icon(gear, Library.Icons.Gear, {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(12, 12), Color = Theme.Knob, Fallback = "ring",
	})
	mod.GearBtn = gear
	mod.GearIcon = gearIcon
	gear.MouseEnter:Connect(function()
		iconColor(gearIcon, Color3.new(1, 1, 1))
		if not mod._gearOpen then
			tween(gearIcon, { Rotation = 45 }, TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out))
		end
	end)
	gear.MouseLeave:Connect(function()
		iconColor(gearIcon, Theme.Knob)
		if not mod._gearOpen then
			tween(gearIcon, { Rotation = 0 }, TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out))
		end
	end)
	gear.MouseButton1Click:Connect(function() mod:OpenSettings() end)

	if mod.HasToggle then
		mod.Switch = makeSwitch(row, 24, 12, function(s)
			mod.Enabled = s
			mod:_tintName(s)
			safe(mod.Callback, s)
		end)
		mod.Switch.Button.AnchorPoint = Vector2.new(1, 0.5)
		mod.Switch.Button.Position = UDim2.new(1, -9, 0.5, 0)
	end

	local hoverBar = new("Frame", {
		Name = "HoverBar", BackgroundColor3 = Theme.Accent, BorderSizePixel = 0, AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 1, 0.5, 0), Size = UDim2.fromOffset(2, 0), Parent = row,
	}, { corner(2) })
	onAccent(function(c) hoverBar.BackgroundColor3 = c end)
	local hti = TweenInfo.new(0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
	hit.MouseEnter:Connect(function()
		tween(row, { BackgroundTransparency = 0.94 }, hti)
		tween(hoverBar, { Size = UDim2.fromOffset(2, 12) }, TweenInfo.new(0.32, Enum.EasingStyle.Back, Enum.EasingDirection.Out))
		tween(nameLbl, { Position = UDim2.fromOffset(11, 0) }, hti)
	end)
	hit.MouseLeave:Connect(function()
		tween(row, { BackgroundTransparency = 1 }, hti)
		tween(hoverBar, { Size = UDim2.fromOffset(2, 0) }, hti)
		tween(nameLbl, { Position = UDim2.fromOffset(8, 0) }, hti)
	end)
	hit.MouseButton1Down:Connect(function() tween(row, { BackgroundTransparency = 0.86 }, TweenInfo.new(0.08)) end)
	hit.MouseButton1Up:Connect(function() tween(row, { BackgroundTransparency = 0.94 }, hti) end)
	hit.MouseButton1Click:Connect(function()
		if mod.HasToggle then mod:Set(not mod.Enabled) else safe(mod.Callback, true) end
	end)
	hit.MouseButton2Click:Connect(function() mod:OpenSettings() end)

	-- встроенный бинд модуля
	if o.Bind ~= false then
		mod.BindObj = Library:_newBind(typeof(o.Bind) == "EnumItem" and o.Bind or nil, o.BindMode or "Toggle", function(state)
			if mod.BindObj.Mode == "Hold" then mod:Set(state) else mod:Set(not mod.Enabled) end
		end)
	end

	if o.Default then mod:Set(true, o.SilentDefault ~= false and false or true) end

	table.insert(self.Modules, mod)
	table.insert(win.AllModules or (function() win.AllModules = {}; return win.AllModules end)(), mod)
	return mod
end

function Module:_tintName(state)
	if self.NameLabel then
		tween(self.NameLabel, { TextColor3 = state and Color3.new(1, 1, 1) or Theme.Text },
			TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out))
	end
end

function Module:Set(state, silent)
	state = state and true or false
	self.Enabled = state
	self:_tintName(state)
	if self.Switch then self.Switch:Set(state, true) end
	if not silent then safe(self.Callback, state) end
end
function Module:Get() return self.Enabled end
function Module:Toggle() self:Set(not self.Enabled) end

function Module:SetBind(key) 
	if self.BindObj then
		self.BindObj.Key = key
		if self.BindEl then self.BindEl:Set(key) end
	end
end


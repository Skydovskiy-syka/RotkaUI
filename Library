-------------------------------------------------------------------------------
-- БИНДЫ (глобальный обработчик)
-------------------------------------------------------------------------------
local function bindMatches(key, input)
	if not key then return false end
	if typeof(key) ~= "EnumItem" then return false end
	if key.EnumType == Enum.KeyCode then
		return input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == key
	end
	return input.UserInputType == key
end

function Library:_newBind(key, mode, fire)
	local bind = { Key = key, Mode = mode or "Toggle", State = false, Fire = fire }
	self._binds[bind] = true
	return bind
end

UserInputService.InputBegan:Connect(function(input, gp)
	if Library._listening or gp then return end
	for bind in pairs(Library._binds) do
		if bindMatches(bind.Key, input) then
			if bind.Mode == "Hold" then
				bind.State = true
			else
				bind.State = not bind.State
			end
			safe(bind.Fire, bind.State)
		end
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if Library._listening then return end
	for bind in pairs(Library._binds) do
		if bind.Mode == "Hold" and bindMatches(bind.Key, input) then
			bind.State = false
			safe(bind.Fire, false)
		end
	end
end)

local function listenForKey(callback)
	Library._listening = true
	local conn
	conn = UserInputService.InputBegan:Connect(function(input)
		local key
		if input.UserInputType == Enum.UserInputType.Keyboard then
			key = input.KeyCode
		elseif input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.MouseButton2
			or input.UserInputType == Enum.UserInputType.MouseButton3 then
			key = input.UserInputType
		else
			return
		end
		conn:Disconnect()
		task.defer(function() Library._listening = false end)
		if key == Enum.KeyCode.Escape or key == Enum.KeyCode.Backspace or key == Enum.KeyCode.Delete then
			key = nil
		end
		callback(key)
	end)
end


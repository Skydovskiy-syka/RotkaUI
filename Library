		Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, Parent = sv,
	}, { corner(5), new("UIGradient", {
		Rotation = 90,
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) }),
	}) })
	local svKnob = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(9, 9), BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0, Parent = sv,
	}, { corner(9), stroke(Color3.new(0, 0, 0), 1.5, 0.2) })

	local hue = textButton({
        BackgroundTransparency = 0,
		BackgroundColor3 = Color3.new(1, 1, 1), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.new(0, 14, 1, 0), Parent = body,
	})
	corner(5).Parent = hue
	new("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
			ColorSequenceKeypoint.new(1 / 6, Color3.fromRGB(255, 255, 0)),
			ColorSequenceKeypoint.new(2 / 6, Color3.fromRGB(0, 255, 0)),
			ColorSequenceKeypoint.new(3 / 6, Color3.fromRGB(0, 255, 255)),
			ColorSequenceKeypoint.new(4 / 6, Color3.fromRGB(0, 0, 255)),
			ColorSequenceKeypoint.new(5 / 6, Color3.fromRGB(255, 0, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 0)),
		}),
		Parent = hue,
	})
	local hueKnob = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.new(1, 4, 0, 3), BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0, Parent = hue,
	}, { corner(2), stroke(Color3.new(0, 0, 0), 1, 0.3) })

	local function apply(fire)
		color = Color3.fromHSV(h, s, v)
		swatch.BackgroundColor3 = color
		sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
		svKnob.Position = UDim2.fromScale(s, 1 - v)
		hueKnob.Position = UDim2.new(0.5, 0, h, 0)
		if fire then safe(callback, color) end
	end
	apply(false)

	local mode
	local function fromInput(i)
		if mode == "sv" then
			s = clamp((i.Position.X - sv.AbsolutePosition.X) / math.max(sv.AbsoluteSize.X, 1), 0, 1)
			v = 1 - clamp((i.Position.Y - sv.AbsolutePosition.Y) / math.max(sv.AbsoluteSize.Y, 1), 0, 1)
		elseif mode == "hue" then
			h = clamp((i.Position.Y - hue.AbsolutePosition.Y) / math.max(hue.AbsoluteSize.Y, 1), 0, 0.999)
		else
			return
		end
		apply(true)
	end
	local function isPress(i)
		return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch
	end
	sv.InputBegan:Connect(function(i) if isPress(i) then mode = "sv"; fromInput(i) end end)
	hue.InputBegan:Connect(function(i) if isPress(i) then mode = "hue"; fromInput(i) end end)
	table.insert(self.Window.Conns, UserInputService.InputChanged:Connect(function(i)
		if mode and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			fromInput(i)
		end
	end))
	table.insert(self.Window.Conns, UserInputService.InputEnded:Connect(function(i)
		if isPress(i) then mode = nil end
	end))

	local open = false
	swatch.MouseButton1Click:Connect(function()
		open = not open
		local ti = TweenInfo.new(0.28, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
		if open then body.Visible = true end
		tween(f, { Size = open and UDim2.new(1, 0, 0, 124) or UDim2.new(1, 0, 0, 24) }, ti)
		tween(swatch, { Size = open and UDim2.fromOffset(34, 14) or UDim2.fromOffset(28, 14) },
			TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out))
		if not open then
			task.delay(0.28, function() if not open then body.Visible = false end end)
		end
	end)

	local el = { Type = "ColorPicker", Name = name }
	function el:Get() return color end
	function el:Set(c, silent)
		if typeof(c) ~= "Color3" then return end
		h, s, v = c:ToHSV()
		apply(not silent)
	end
	table.insert(self.Elements, el)
	return el
end

-- KEYBIND ------------------------------------------------------------------
function Module:_keybind(name, bind, order)
	local f = self:_row(24, order)
	elementLabel(f, name)
	local btn = textButton({
		Text = keyName(bind.Key), TextSize = 10, TextColor3 = Theme.TextDim, BackgroundColor3 = Theme.Element,
		BackgroundTransparency = 0.1, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0, 12),
		Size = UDim2.fromOffset(70, 20), Parent = f,
	})
	corner(5).Parent = btn
	local listening = false
	btn.MouseButton1Click:Connect(function()
		if listening then return end
		listening = true
		btn.Text = "..."
		btn.TextColor3 = Theme.Accent
		listenForKey(function(k)
			listening = false
			bind.Key = k
			btn.Text = keyName(k)
			btn.TextColor3 = Theme.TextDim
		end)
	end)
	local el = { Type = "Keybind", Name = name, Bind = bind }
	function el:Get() return bind.Key end
	function el:Set(k) bind.Key = k; btn.Text = keyName(k) end
	return el
end

function Module:AddKeybind(name, o, callback)
	o = o or {}
	local bind = Library:_newBind(o.Default, o.Mode or "Toggle", function(state) safe(callback, state) end)
	local el = self:_keybind(name, bind)
	table.insert(self.Elements, el)
	return el
end

-- TEXTBOX ------------------------------------------------------------------
function Module:AddTextBox(name, o, callback)
	o = o or {}
	local f = self:_row(24)
	elementLabel(f, name, UDim2.new(0.4, 0, 0, 24))
	local box = new("TextBox", {
		BackgroundColor3 = Theme.Element, BackgroundTransparency = 0.1, BorderSizePixel = 0,
		AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0, 12), Size = UDim2.new(0.58, 0, 0, 20),
		Text = o.Default or "", PlaceholderText = o.Placeholder or "...", PlaceholderColor3 = Theme.Label,
		TextColor3 = Theme.Text, ClearTextOnFocus = false, FontFace = font(), TextSize = 11,
		ClipsDescendants = true, Parent = f,
	}, { corner(5), padding(6, 0, 6, 0) })
	box.FocusLost:Connect(function() safe(callback, box.Text) end)
	local el = { Type = "TextBox", Name = name }
	function el:Get() return box.Text end
	function el:Set(t, silent) box.Text = tostring(t); if not silent then safe(callback, box.Text) end end
	table.insert(self.Elements, el)
	return el
end

-- BUTTON / LABEL / SEPARATOR ----------------------------------------------
function Module:AddButton(name, callback)
	local f = self:_row(24)
	local b = textButton({
		Text = name, TextSize = 11, BackgroundColor3 = Theme.Element, BackgroundTransparency = 0.1,
		Size = UDim2.fromScale(1, 1), Parent = f,
	})
	corner(6).Parent = b
	b.MouseEnter:Connect(function() tween(b, { BackgroundColor3 = Theme.Off }) end)
	b.MouseLeave:Connect(function() tween(b, { BackgroundColor3 = Theme.Element }) end)
	local bs = new("UIScale", { Scale = 1, Parent = b })
	b.MouseButton1Down:Connect(function()
		tween(bs, { Scale = 0.95 }, TweenInfo.new(0.07, Enum.EasingStyle.Quad, Enum.EasingDirection.Out))
	end)
	b.MouseButton1Up:Connect(function()
		tween(bs, { Scale = 1 }, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out))
	end)
	b.MouseLeave:Connect(function()
		tween(bs, { Scale = 1 }, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out))
	end)
	b.MouseButton1Click:Connect(function() safe(callback) end)
	return b
end

function Module:AddLabel(str)
	local f = self:_row(16)
	local l = text({ Text = str, TextSize = 10, TextColor3 = Theme.Label, Size = UDim2.fromScale(1, 1), TextWrapped = true, Parent = f })
	return { Set = function(_, t) l.Text = t end }
end

function Module:AddSeparator()
	local f = self:_row(7)
	new("Frame", {
		BackgroundColor3 = Theme.Stroke, BackgroundTransparency = 0.4, BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.new(1, 0, 0, 1), Parent = f,
	})
end

function Library:Destroy()
	for _, w in ipairs(self.Windows) do pcall(function() w:Destroy() end) end
	self.Windows = {}
end


function Window:ExportConfig()
	local out = { accent = ser(Theme.Accent), modules = {} }
	for _, tab in ipairs(self.Tabs) do
		for _, g in ipairs(tab.Groups) do
			for _, m in ipairs(g.Modules) do
				local e = { enabled = m.Enabled, settings = {} }
				if m.BindObj then
					e.bind = ser(m.BindObj.Key)
					e.mode = m.BindObj.Mode
				end
				for _, el in ipairs(m.Elements) do
					if el.Get then e.settings[el.Name] = ser(el:Get()) end
				end
				out.modules[tab.Name .. "/" .. m.Name] = e
			end
		end
	end
	return out
end

function Window:ImportConfig(data)
	if type(data) ~= "table" then return false end
	if data.accent then
		local c = deser(data.accent)
		if typeof(c) == "Color3" then Library:SetAccent(c) end
	end
	for _, tab in ipairs(self.Tabs) do
		for _, g in ipairs(tab.Groups) do
			for _, m in ipairs(g.Modules) do
				local e = (data.modules or {})[tab.Name .. "/" .. m.Name]
				if e then
					if m.BindObj then
						m.BindObj.Key = deser(e.bind)
						if e.mode then m.BindObj.Mode = e.mode end
						if m.BindEl then m.BindEl:Set(m.BindObj.Key) end
						if m.ModeEl then m.ModeEl:Set(m.BindObj.Mode, true) end
					end
					for _, el in ipairs(m.Elements) do
						local v = e.settings and e.settings[el.Name]
						if v ~= nil and el.Set then pcall(function() el:Set(deser(v)) end) end
					end
					if m.HasToggle and e.enabled ~= nil then m:Set(e.enabled) end
				end
			end
		end
	end
	return true
end

function Window:GetConfigs()
	local list = {}
	if HasFS then
		pcall(function()
			if not isfolder(self.ConfigFolder) then makefolder(self.ConfigFolder) end
			for _, p in ipairs(listfiles(self.ConfigFolder)) do
				local n = tostring(p):match("([^/\\]+)%.json$")
				if n then table.insert(list, n) end
			end
		end)
	else
		for n in pairs(self._memCfg) do table.insert(list, n) end
	end
	table.sort(list)
	return list
end

function Window:SaveConfig(name)
	name = tostring(name or ""):gsub("[^%w_%-%s]", ""):gsub("^%s+", ""):gsub("%s+$", "")
	if name == "" then return false end
	local ok, json = pcall(function() return HttpService:JSONEncode(self:ExportConfig()) end)
	if not ok then return false end
	if HasFS then
		local wrote = pcall(function()
			if not isfolder(self.ConfigFolder) then makefolder(self.ConfigFolder) end
			writefile(self.ConfigFolder .. "/" .. name .. ".json", json)
		end)
		if not wrote then return false end
	else
		self._memCfg[name] = json
	end
	return true, name
end

function Window:LoadConfig(name)
	local json
	if HasFS then
		local ok, res = pcall(function() return readfile(self.ConfigFolder .. "/" .. name .. ".json") end)
		if ok then json = res end
	else
		json = self._memCfg[name]
	end
	if not json then return false end
	local ok, data = pcall(function() return HttpService:JSONDecode(json) end)
	if not ok then return false end
	return self:ImportConfig(data)
end

function Window:DeleteConfig(name)
	if HasFS and typeof(delfile) == "function" then
		pcall(function() delfile(self.ConfigFolder .. "/" .. name .. ".json") end)
	end
	self._memCfg[name] = nil
end


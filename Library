function Window:_openConfigPopup(btn)
	if self._cfgPopup and self._popup == self._cfgPopup then self:ClosePopup(); return end

	if not self._cfgPopup then
		local popup, scroller, layout = makePopup(self, 230, "Configs", 300)
		self._cfgPopup, self._cfgScroller = popup, scroller

		-- строка создания
		local createRow = new("Frame", {
			BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 24), LayoutOrder = 1, Parent = scroller,
		})
		local box = new("TextBox", {
			BackgroundColor3 = Theme.Element, Position = UDim2.fromOffset(0, 0), Size = UDim2.new(1, -62, 1, 0),
			Text = "", PlaceholderText = "Config name...", PlaceholderColor3 = Theme.Label,
			TextColor3 = Theme.Text, ClearTextOnFocus = false, FontFace = font(), TextSize = 11,
			BorderSizePixel = 0, Parent = createRow,
		}, { corner(6), padding(8, 0, 8, 0) })
		local createBtn = textButton({
			Text = "Create", BackgroundColor3 = Theme.Accent, BackgroundTransparency = 0.15,
			AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0, 56, 1, 0),
			Weight = Enum.FontWeight.Bold, TextSize = 11, TextColor3 = Color3.new(1, 1, 1), Parent = createRow,
		}, nil)
		corner(6).Parent = createBtn

		local listFrame = new("Frame", {
			BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = 2, Parent = scroller,
		}, { new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 3) }) })

		local function refresh()
			for _, c in ipairs(listFrame:GetChildren()) do
				if c:IsA("Frame") then c:Destroy() end
			end
			local cfgs = self:GetConfigs()
			if #cfgs == 0 then
				local empty = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 22), Parent = listFrame })
				text({
					Text = "No configs yet", TextColor3 = Theme.Label, TextSize = 11,
					Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, Parent = empty,
				})
			end
			for i, name in ipairs(cfgs) do
				local row = new("Frame", {
					BackgroundColor3 = Theme.Element, BackgroundTransparency = 0.35, BorderSizePixel = 0,
					Size = UDim2.new(1, 0, 0, 26), LayoutOrder = i, Parent = listFrame,
				}, { corner(6) })
				text({
					Text = name, TextSize = 11,
					TextColor3 = (name == self.CurrentConfig) and Theme.Accent or Theme.Text,
					Position = UDim2.fromOffset(8, 0), Size = UDim2.new(1, -112, 1, 0),
					TextTruncate = Enum.TextTruncate.AtEnd, Parent = row,
				})
				local function mini(label, xRight, color, cb)
					local b = textButton({
						Text = label, TextSize = 10, Weight = Enum.FontWeight.Bold, TextColor3 = color,
						BackgroundColor3 = Theme.Off, BackgroundTransparency = 0.2,
						AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, xRight, 0.5, 0),
						Size = UDim2.fromOffset(32, 18), Parent = row,
					})
					corner(5).Parent = b
					b.MouseButton1Click:Connect(cb)
				end
				mini("Del", -4, Theme.Danger, function()
					self:DeleteConfig(name)
					refresh()
				end)
				mini("Save", -38, Theme.TextDim, function()
					if self:SaveConfig(name) then
						self:_setCurrentConfig(name)
						self:Notify({ Title = "Config", Text = "Saved: " .. name })
						refresh()
					end
				end)
				mini("Load", -72, Theme.Accent, function()
					if self:LoadConfig(name) then
						self:_setCurrentConfig(name)
						self:Notify({ Title = "Config", Text = "Loaded: " .. name })
						refresh()
					else
						self:Notify({ Title = "Config", Text = "Failed to load: " .. name })
					end
				end)
			end
		end
		self._cfgRefresh = refresh

		local function create()
			local ok, saved = self:SaveConfig(box.Text)
			if ok then
				self:_setCurrentConfig(saved)
				box.Text = ""
				self:Notify({ Title = "Config", Text = "Created: " .. saved })
				refresh()
			end
		end
		createBtn.MouseButton1Click:Connect(create)
		box.FocusLost:Connect(function(enter) if enter then create() end end)
	end

	self._cfgRefresh()
	self:_showPopup(self._cfgPopup, self:_anchorOf(btn, "below"), function() self:_spinArrow(false) end)
	self:_spinArrow(true)
end


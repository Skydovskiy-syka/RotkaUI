local function makeSwitch(parent, w, h, onChange)
	local obj = { State = false }
	local ks = h - 4
	local track = new("TextButton", {
		Name = "Switch", Text = "", AutoButtonColor = false, BackgroundColor3 = Theme.Off,
		BorderSizePixel = 0, Size = UDim2.fromOffset(w, h), Parent = parent,
	}, { corner(h) })
	local knob = new("Frame", {
		Name = "Knob", BackgroundColor3 = Theme.Knob, BorderSizePixel = 0,
		Position = UDim2.fromOffset(2, 2), Size = UDim2.fromOffset(ks, ks), Parent = track,
	}, { corner(ks) })
	obj.Button = track

	local function render(anim)
		local ti = anim and TweenInfo.new(0.22, Enum.EasingStyle.Quint, Enum.EasingDirection.Out) or TweenInfo.new(0)
		tween(track, { BackgroundColor3 = obj.State and Theme.Accent or Theme.Off }, ti)
		tween(knob, {
			Position = obj.State and UDim2.fromOffset(w - ks - 2, 2) or UDim2.fromOffset(2, 2),
			BackgroundColor3 = obj.State and Color3.new(1, 1, 1) or Theme.Knob,
		}, ti)
		if anim then
			-- "резиновый" ползунок: растягивается в движении и пружинит назад
			tween(knob, { Size = UDim2.fromOffset(ks + 3, ks) }, TweenInfo.new(0.07, Enum.EasingStyle.Quad, Enum.EasingDirection.Out))
			task.delay(0.07, function()
				tween(knob, { Size = UDim2.fromOffset(ks, ks) }, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out))
			end)
		end
	end

	function obj:Set(v, silent)
		obj.State = v and true or false
		render(true)
		if not silent and onChange then onChange(obj.State) end
	end
	function obj:Get() return obj.State end

	track.MouseButton1Click:Connect(function() obj:Set(not obj.State) end)
	onAccent(function() render(false) end)
	return obj
end

-- Базовый popup: возвращает popup, scroller, layout, resize()
local function makePopup(win, width, title, maxH)
	local popup = new("Frame", {
		Name = "Popup", BackgroundColor3 = Theme.Popup, BackgroundTransparency = 0.02,
		BorderSizePixel = 0, Size = UDim2.fromOffset(width, 60), Visible = false,
		Parent = win.PopupLayer,
	}, { corner(10), stroke(Theme.Stroke, 1, 0.1) })
	new("UIScale", { Name = "PopScale", Scale = 1, Parent = popup })

	text({
		Text = title, Weight = Enum.FontWeight.Bold, TextSize = 12,
		Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -24, 0, 30), Parent = popup,
	})
	new("Frame", {
		BackgroundColor3 = Theme.Stroke, BackgroundTransparency = 0.4, BorderSizePixel = 0,
		Position = UDim2.fromOffset(10, 29), Size = UDim2.new(1, -20, 0, 1), Parent = popup,
	})

	local layout = new("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 4),
	})
	local scroller = new("ScrollingFrame", {
		Name = "Content", BackgroundTransparency = 1, BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 31), Size = UDim2.new(1, 0, 0, 30),
		CanvasSize = UDim2.new(), ScrollBarThickness = 2, ScrollBarImageColor3 = Theme.Knob,
		ScrollBarImageTransparency = 0.4, VerticalScrollBarInset = Enum.ScrollBarInset.None,
		Parent = popup,
	}, { padding(9, 6, 9, 6), layout })

	local function resize()
		local ch = layout.AbsoluteContentSize.Y + 12
		local sh = math.min(ch, maxH or 270)
		scroller.Size = UDim2.new(1, 0, 0, sh)
		scroller.CanvasSize = UDim2.fromOffset(0, ch)
		popup.Size = UDim2.fromOffset(width, 31 + sh)
		if win._popup == popup then win:_placePopup() end
	end
	layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(resize)
	resize()
	win._resizers = win._resizers or {}
	win._resizers[popup] = resize
	return popup, scroller, layout, resize
end


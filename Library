local FONT_FAMILY = "rbxasset://fonts/families/GothamSSm.json"
local function font(weight)
	return Font.new(FONT_FAMILY, weight or Enum.FontWeight.Medium, Enum.FontStyle.Normal)
end

local TI_FAST = TweenInfo.new(0.16, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
local function tween(obj, props, ti)
	local t = TweenService:Create(obj, ti or TI_FAST, props)
	t:Play()
	return t
end

local function new(class, props, children)
	local inst = Instance.new(class)
	local parent
	for k, v in pairs(props or {}) do
		if k == "Parent" then parent = v else inst[k] = v end
	end
	for _, c in ipairs(children or {}) do c.Parent = inst end
	if parent then inst.Parent = parent end
	return inst
end

local function corner(r) return new("UICorner", { CornerRadius = UDim.new(0, r) }) end
local function stroke(color, thickness, transparency)
	return new("UIStroke", {
		Color = color, Thickness = thickness or 1, Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end
local function padding(l, t, r, b)
	return new("UIPadding", {
		PaddingLeft = UDim.new(0, l or 0), PaddingTop = UDim.new(0, t or 0),
		PaddingRight = UDim.new(0, r or 0), PaddingBottom = UDim.new(0, b or 0),
	})
end

local function text(p)
	local props = {
		BackgroundTransparency = 1, BorderSizePixel = 0, Text = "",
		FontFace = font(p.Weight), TextSize = 12, TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
	}
	p.Weight = nil
	for k, v in pairs(p) do props[k] = v end
	return new("TextLabel", props)
end

local function textButton(p)
	local props = {
		BackgroundTransparency = 1, BorderSizePixel = 0, Text = "", AutoButtonColor = false,
		FontFace = font(p.Weight), TextSize = 12, TextColor3 = Theme.Text,
	}
	p.Weight = nil
	for k, v in pairs(p) do props[k] = v end
	return new("TextButton", props)
end

local function safe(fn, ...)
	if typeof(fn) ~= "function" then return end
	local ok, err = pcall(fn, ...)
	if not ok then warn("[PhobiaUI] callback error: " .. tostring(err)) end
end

local function clamp(v, a, b) return math.max(a, math.min(b, v)) end

local function assetId(v)
	if v == nil or v == "" then return "" end
	if type(v) == "number" then return "rbxassetid://" .. v end
	if tostring(v):match("^%d+$") then return "rbxassetid://" .. v end
	return tostring(v)
end

-- Иконка с заглушкой (пока AssetID пустой)
local function icon(parent, id, o)
	o = o or {}
	local color = o.Color or Color3.new(1, 1, 1)
	local img = new("ImageLabel", {
		Name = o.Name or "Icon", BackgroundTransparency = 1, BorderSizePixel = 0,
		AnchorPoint = o.AnchorPoint or Vector2.zero, Position = o.Position or UDim2.new(),
		Size = o.Size or UDim2.fromOffset(12, 12), ImageColor3 = color,
		Image = assetId(id), ScaleType = Enum.ScaleType.Fit, Parent = parent,
	})
	local fb = new("Frame", {
		Name = "Fallback", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1),
		Visible = assetId(id) == "", Parent = img,
	})
	if o.Fallback == "ring" then
		new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(0.72, 0.72), BackgroundTransparency = 1, Parent = fb,
		}, { corner(999), stroke(color, 1.5) })
	elseif o.Fallback == "square" then
		new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(0.7, 0.7), BackgroundTransparency = 1, Parent = fb,
		}, { corner(3), stroke(color, 1.3) })
	elseif o.Fallback == "letter" then
		text({
			Text = o.Letter or "P", Size = UDim2.fromScale(1, 1), Weight = Enum.FontWeight.Heavy,
			TextSize = 26, TextColor3 = o.FallbackColor or Color3.fromRGB(182, 150, 240),
			TextXAlignment = Enum.TextXAlignment.Center, Parent = fb,
		})
	end
	return img
end

local function iconColor(img, c)
	img.ImageColor3 = c
	local fb = img:FindFirstChild("Fallback")
	if fb then
		for _, d in ipairs(fb:GetDescendants()) do
			if d:IsA("UIStroke") then d.Color = c end
		end
	end
end

local function iconSet(img, id)
	img.Image = assetId(id)
	local fb = img:FindFirstChild("Fallback")
	if fb then fb.Visible = assetId(id) == "" end
end

local function keyName(k)
	if not k then return "None" end
	if typeof(k) == "EnumItem" then
		local n = k.Name
		if k.EnumType == Enum.UserInputType then
			n = ({ MouseButton1 = "M1", MouseButton2 = "M2", MouseButton3 = "M3" })[n] or n
		end
		return n
	end
	return tostring(k)
end

local function fmtNumber(v, inc)
	local s = tostring(inc)
	local dot = s:find("%.")
	local d = dot and (#s - dot) or 0
	return string.format("%." .. d .. "f", v)
end

-- Сериализация значений для конфигов
local function ser(v)
	local t = typeof(v)
	if t == "Color3" then return { __c = { v.R, v.G, v.B } } end
	if t == "EnumItem" then return { __e = { tostring(v.EnumType), v.Name } } end
	return v
end
local function deser(v)
	if type(v) == "table" then
		if v.__c then return Color3.new(v.__c[1], v.__c[2], v.__c[3]) end
		if v.__e then
			local ok, r = pcall(function() return Enum[v.__e[1]][v.__e[2]] end)
			return ok and r or nil
		end
	end
	return v
end

